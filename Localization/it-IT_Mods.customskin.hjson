Configs: {
	CustomSkinServerConfig: {
		DisplayName: Configurazione server CustomSkin

		AllowSkinUploads: {
			Label: Consenti caricamento skin dei giocatori
			Tooltip: Se disattivato, il server non richiede più nuovi dati delle skin. Le skin già memorizzate e non vietate restano disponibili.
		}

		MaxUploadKiB: {
			Label: Limite di caricamento per skin (KiB)
			Tooltip: Limita ogni risorsa skin normalizzata accettata dal server. Il limite rigido del protocollo è 800 KiB.
		}

		MaxCachedResources: {
			Label: Numero massimo di skin in cache
			Tooltip: Numero massimo di skin multigiocatore diverse conservate durante questa sessione del server.
		}

		MaxCachedResourceMiB: {
			Label: Dimensione massima cache (MiB)
			Tooltip: Limite totale di memoria per le risorse skin multigiocatore memorizzate dal server.
		}

		UploadCooldownSeconds: {
			Label: Attesa richieste di caricamento per giocatore (secondi)
			Tooltip: Limita la frequenza con cui il server richiede nuovamente i dati della skin allo stesso giocatore.
		}

		BannedSkinHashes: {
			Label: Hash delle skin vietate
			Tooltip: Inserisci un hash SHA-256 di 64 caratteri per riga. Le skin corrispondenti non vengono caricate, assegnate o distribuite e scompaiono dopo aver applicato la configurazione.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Sempre
			Tooltip: Abilita sempre la skin locale selezionata.
		}

		AccessoryOnly: {
			$parentVal: Solo accessorio
			Tooltip: Abilita la skin selezionata solo quando Custom Skin Core è visibile.
		}

		Disabled: {
			$parentVal: Disattivato
			Tooltip: Disabilita la skin locale selezionata.
		}

		Tooltip: Scegli quando mostrare la skin del personaggio locale.
	}

	CustomSkinClientConfig: {
		DisplayName: Configurazione client CustomSkin

		EnableMode: {
			Label: Modalità di attivazione skin
			Tooltip: Usa sempre la skin selezionata, richiedi un Custom Skin Core visibile oppure disabilita le skin locali.
		}

		ShowRemoteSkins: {
			Label: Mostra le CustomSkin degli altri giocatori
			Tooltip: Se disattivato, le skin multigiocatore remote non vengono richieste né mostrate. La skin locale non cambia.
		}

		BlockedPlayerNames: {
			Label: Nascondi skin in base al nome del giocatore
			Tooltip: I nomi corrispondenti nascondono solo la CustomSkin del giocatore, non il giocatore o la chat. Il confronto ignora maiuscole e minuscole; aggiorna l'elenco se il giocatore cambia nome.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Apri gestione skin

Commands: {
	Description: Apre la gestione CustomSkin o ricarica le skin multigiocatore.
	Usage: Utilizzo: /cskin oppure /cskin reload
}

Network: {
	ReloadStarted: Risicronizzazione delle skin multigiocatore richiesta. Gli aspetti remoti torneranno dopo la convalida.
	ReloadUnavailable: /cskin reload può essere usato solo dopo essere entrati in un mondo multigiocatore.
	ReloadHint: Usa /cskin reload per risincronizzare manualmente.
	ServerRejected: Il server ha rifiutato il trasferimento di una skin oppure la convalida non è riuscita.
	UploadTimeout: Il caricamento della skin selezionata sul server è scaduto.
	DownloadTimeout: Il download della skin di un altro giocatore è scaduto.
	LocalError: Si è verificato un errore durante l'elaborazione dei dati skin multigiocatore. Controlla il registro del client per i dettagli.
}

