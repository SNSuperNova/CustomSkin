Configs: {
	CustomSkinServerConfig: {
		DisplayName: Ustawienia serwera CustomSkin

		AllowSkinUploads: {
			Label: Zezwalaj graczom na wysyłanie skórek
			Tooltip: Po wyłączeniu serwer przestaje żądać nowych danych skórek. Skórki już zapisane w pamięci podręcznej i niezablokowane pozostają dostępne.
		}

		MaxUploadKiB: {
			Label: Limit wysyłania jednej skórki (KiB)
			Tooltip: Ogranicza każdy znormalizowany zasób skórki przyjmowany przez serwer. Twardy limit protokołu wynosi 800 KiB.
		}

		MaxCachedResources: {
			Label: Maksymalna liczba skórek w pamięci
			Tooltip: Maksymalna liczba różnych skórek wieloosobowych przechowywanych podczas tej sesji serwera.
		}

		MaxCachedResourceMiB: {
			Label: Maksymalny rozmiar pamięci podręcznej (MiB)
			Tooltip: Łączny limit pamięci zasobów skórek wieloosobowych przechowywanych przez serwer.
		}

		UploadCooldownSeconds: {
			Label: Odstęp żądań wysyłania gracza (sekundy)
			Tooltip: Ogranicza częstotliwość ponownego żądania danych skórki od tego samego gracza.
		}

		BannedSkinHashes: {
			Label: Skróty zablokowanych skórek
			Tooltip: Wpisz jeden 64-znakowy skrót SHA-256 w każdym wierszu. Pasujące skórki nie są wysyłane, przypisywane ani udostępniane i znikają po zastosowaniu ustawień.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Zawsze
			Tooltip: Zawsze włącza wybraną lokalną skórkę.
		}

		AccessoryOnly: {
			$parentVal: Tylko akcesorium
			Tooltip: Włącza wybraną skórkę tylko wtedy, gdy Custom Skin Core jest widoczny.
		}

		Disabled: {
			$parentVal: Wyłączone
			Tooltip: Wyłącza wybraną lokalną skórkę.
		}

		Tooltip: Wybierz, kiedy ma być wyświetlana lokalna skórka postaci.
	}

	CustomSkinClientConfig: {
		DisplayName: Ustawienia klienta CustomSkin

		EnableMode: {
			Label: Tryb włączenia skórki
			Tooltip: Zawsze używaj wybranej skórki, wymagaj widocznego Custom Skin Core lub wyłącz lokalne skórki.
		}

		ShowRemoteSkins: {
			Label: Pokazuj CustomSkin innych graczy
			Tooltip: Po wyłączeniu zdalne skórki wieloosobowe nie są żądane ani wyświetlane. Lokalna skórka pozostaje bez zmian.
		}

		BlockedPlayerNames: {
			Label: Ukrywaj skórki według nazw graczy
			Tooltip: Pasujące nazwy ukrywają tylko CustomSkin gracza, a nie gracza ani czat. Wielkość liter jest ignorowana; zaktualizuj listę, jeśli gracz zmieni nazwę.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Otwórz menedżer skórek

Commands: {
	Description: Otwiera menedżer CustomSkin lub ponownie wczytuje skórki wieloosobowe.
	Usage: Użycie: /cskin lub /cskin reload
}

Network: {
	ReloadStarted: Zażądano ponownej synchronizacji skórek wieloosobowych. Zdalny wygląd wróci po weryfikacji.
	ReloadUnavailable: /cskin reload można użyć dopiero po wejściu do świata wieloosobowego.
	ReloadHint: Użyj /cskin reload, aby zsynchronizować ręcznie.
	ServerRejected: Serwer odrzucił przesyłanie skórki lub jej weryfikacja nie powiodła się.
	UploadTimeout: Upłynął limit czasu wysyłania wybranej skórki na serwer.
	DownloadTimeout: Upłynął limit czasu pobierania skórki innego gracza.
	LocalError: Podczas przetwarzania danych skórki wieloosobowej wystąpił błąd. Szczegóły znajdziesz w dzienniku klienta.
}

