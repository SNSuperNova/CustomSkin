	ImportHints: {
		Package: Rebuild the package with create-customskin export; do not manually add, remove, or rename files inside it.
		Manifest: Fix the indicated manifest.json field, or export again from a standard authoring project.
		Image: Re-export the indicated file using the required dimensions and non-interlaced 8-bit RGBA PNG format.
		License: Save LICENSE.txt as valid UTF-8 under 64 KiB, or omit it because a license file is optional.
		Creator: Restore the required template filenames and folders, save the PNG files, then click Refresh & Use again.
		Repository: Confirm that the skin still exists in the library and import again; retain the error code if it persists.
		Unknown: Retain the error code and detail when reporting the problem; do not bypass validation by deleting required files.
	}

	ImportSummary: Import complete: {0} new, {1} already installed.
	ExampleReady: The bundled example was imported and selected.
	OperationFailed: Operation failed. Code: {0}  Detail: {1}
}

Errors: {
	Package: The skin package structure or file set is invalid.
	Manifest: The skin manifest contains a missing, unsupported, or invalid field.
	Image: A skin image has an invalid format, size, structure, or checksum.
	License: The optional license text has an invalid encoding, character, or size.
	Project: The creator project is missing a required file or cannot be accessed safely.
	Repository: The installed skin library entry is missing, damaged, or conflicts with an existing entry.
	Selection: The saved character skin selection is invalid or no longer available.
	Editor: The pixel editor could not safely complete the requested operation.
	Network: Multiplayer skin data is invalid or exceeds an allowed limit.
	Unknown: An unexpected error occurred. Check the client log and retain the displayed error code.
}

Items: {
	CustomSkinCore: {
		DisplayName: Custom Skin Core
		Tooltip: Enables the selected skin when Accessory Only mode is active.
	}
}
