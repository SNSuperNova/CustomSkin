Configs: {
	CustomSkinServerConfig: {
		DisplayName: Custom Skin Server Config

		AllowSkinUploads: {
			Label: Allow Player Skin Uploads
			Tooltip: When disabled, the server stops requesting new skin data. Already cached, non-banned skins remain available.
		}

		MaxUploadKiB: {
			Label: Per-Skin Upload Limit (KiB)
			Tooltip: Limits each normalized skin resource accepted by the server. The protocol hard limit is 800 KiB.
		}

		MaxCachedResources: {
			Label: Maximum Cached Skin Count
			Tooltip: Maximum number of different multiplayer skins kept during this server session.
		}

		MaxCachedResourceMiB: {
			Label: Maximum Cache Size (MiB)
			Tooltip: Total memory limit for multiplayer skin resources cached by the server.
		}

		UploadCooldownSeconds: {
			Label: Per-Player Upload Request Cooldown (Seconds)
			Tooltip: Limits how frequently the server requests skin data again from the same player.
		}

		BannedSkinHashes: {
			Label: Banned Skin Hashes
			Tooltip: Enter one 64-character SHA-256 hash per row. Matching skins are not uploaded, assigned, or served and disappear after applying the config.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Always
			Tooltip: Always enables the selected local skin.
		}

		AccessoryOnly: {
			$parentVal: Accessory Only
			Tooltip: Enables the selected skin only while the Custom Skin Core is visible.
		}

		Disabled: {
			$parentVal: Disabled
			Tooltip: Disables the selected local skin.
		}

		Tooltip: Select when the local character skin is displayed.
	}

	CustomSkinClientConfig: {
		DisplayName: Custom Skin Client Config

		EnableMode: {
			Label: Skin Enable Mode
			Tooltip: Always use the selected skin, require a visible Custom Skin Core, or disable local skins.
		}

		ShowRemoteSkins: {
			Label: Show Other Players' CustomSkins
			Tooltip: When disabled, remote multiplayer skins are neither requested nor displayed. Your local skin is unaffected.
		}

		BlockedPlayerNames: {
			Label: Hide Skins From Player Names
			Tooltip: Matching names hide only that player's CustomSkin, not the player or chat. Matching ignores case; update the list if the player changes names.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Open Skin Manager

Commands: {
	Description: Open the CustomSkin manager or reload multiplayer skins.
	Usage: Usage: /cskin or /cskin reload
}

Network: {
	ReloadStarted: Multiplayer skin resync requested. Remote appearances will return after validation.
	ReloadUnavailable: /cskin reload can only be used after entering a multiplayer world.
	ReloadHint: Use /cskin reload to resync manually.
	ServerRejected: The server rejected a skin transfer or its validation failed.
	UploadTimeout: Uploading the selected skin to the server timed out.
	DownloadTimeout: Downloading another player's skin timed out.
	LocalError: An error occurred while processing multiplayer skin data. Check the client log for details.
}

