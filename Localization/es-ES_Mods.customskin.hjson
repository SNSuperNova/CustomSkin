Configs: {
	CustomSkinServerConfig: {
		DisplayName: Configuración del servidor CustomSkin

		AllowSkinUploads: {
			Label: Permitir subir skins de jugadores
			Tooltip: Al desactivarlo, el servidor deja de solicitar nuevos datos de skins. Las skins ya almacenadas y no bloqueadas siguen disponibles.
		}

		MaxUploadKiB: {
			Label: Límite de subida por skin (KiB)
			Tooltip: Limita cada recurso de skin normalizado que acepta el servidor. El límite estricto del protocolo es 800 KiB.
		}

		MaxCachedResources: {
			Label: Máximo de skins en caché
			Tooltip: Número máximo de skins multijugador diferentes conservadas durante esta sesión del servidor.
		}

		MaxCachedResourceMiB: {
			Label: Tamaño máximo de caché (MiB)
			Tooltip: Límite total de memoria para los recursos de skins multijugador almacenados por el servidor.
		}

		UploadCooldownSeconds: {
			Label: Espera de solicitudes de subida por jugador (segundos)
			Tooltip: Limita la frecuencia con la que el servidor vuelve a solicitar datos de skin al mismo jugador.
		}

		BannedSkinHashes: {
			Label: Hashes de skins bloqueadas
			Tooltip: Introduce un hash SHA-256 de 64 caracteres por fila. Las skins coincidentes no se suben, asignan ni distribuyen, y desaparecen al aplicar la configuración.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Siempre
			Tooltip: Activa siempre la skin local seleccionada.
		}

		AccessoryOnly: {
			$parentVal: Solo accesorio
			Tooltip: Activa la skin seleccionada solo mientras Custom Skin Core sea visible.
		}

		Disabled: {
			$parentVal: Desactivado
			Tooltip: Desactiva la skin local seleccionada.
		}

		Tooltip: Elige cuándo se muestra la skin del personaje local.
	}

	CustomSkinClientConfig: {
		DisplayName: Configuración del cliente CustomSkin

		EnableMode: {
			Label: Modo de activación de skin
			Tooltip: Usa siempre la skin elegida, exige un Custom Skin Core visible o desactiva las skins locales.
		}

		ShowRemoteSkins: {
			Label: Mostrar CustomSkins de otros jugadores
			Tooltip: Al desactivarlo, no se solicitan ni muestran skins multijugador remotas. Tu skin local no cambia.
		}

		BlockedPlayerNames: {
			Label: Ocultar skins según el nombre del jugador
			Tooltip: Los nombres coincidentes solo ocultan la CustomSkin del jugador, no al jugador ni el chat. No distingue mayúsculas; actualiza la lista si el jugador cambia de nombre.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Abrir gestor de skins

Commands: {
	Description: Abre el gestor de CustomSkin o recarga las skins multijugador.
	Usage: Uso: /cskin o /cskin reload
}

Network: {
	ReloadStarted: Se solicitó resincronizar las skins multijugador. Las apariencias remotas volverán tras validarse.
	ReloadUnavailable: /cskin reload solo se puede usar tras entrar en un mundo multijugador.
	ReloadHint: Usa /cskin reload para resincronizar manualmente.
	ServerRejected: El servidor rechazó una transferencia de skin o su validación falló.
	UploadTimeout: Se agotó el tiempo al subir la skin seleccionada al servidor.
	DownloadTimeout: Se agotó el tiempo al descargar la skin de otro jugador.
	LocalError: Ocurrió un error al procesar datos de skins multijugador. Consulta el registro del cliente para más detalles.
}

