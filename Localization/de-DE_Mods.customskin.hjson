Configs: {
	CustomSkinServerConfig: {
		DisplayName: Benutzerdefinierte Skin-Serverkonfiguration

		AllowSkinUploads: {
			Label: Spieler-Skin-Uploads zulassen
			Tooltip: Wenn deaktiviert, hört der Server auf, neue Skin-Daten anzufordern. Bereits zwischengespeicherte, nicht gesperrte Skins bleiben verfügbar.
		}

		MaxUploadKiB: {
			Label: Upload-Limit pro Haut (KiB)
			Tooltip: Beschränkt jede vom Server akzeptierte normalisierte Skin-Ressource. Das Protokoll-Hard-Limit beträgt 800 KiB.
		}

		MaxCachedResources: {
			Label: Maximale Anzahl zwischengespeicherter Skins
			Tooltip: Maximale Anzahl verschiedener Multiplayer-Skins, die während dieser Serversitzung aufbewahrt werden.
		}

		MaxCachedResourceMiB: {
			Label: Maximale Cache-Größe (MiB)
			Tooltip: Gesamtspeicherlimit für vom Server zwischengespeicherte Multiplayer-Skin-Ressourcen.
		}

		UploadCooldownSeconds: {
			Label: Abklingzeit pro Spieler-Upload-Anfrage (Sekunden)
			Tooltip: Beschränkt die Häufigkeit, mit der der Server erneut Skin-Daten vom selben Player anfordert.
		}

		BannedSkinHashes: {
			Label: Verbotene Skin-Hashes
			Tooltip: Geben Sie einen 64-stelligen SHA-256-Hash pro Zeile ein. Passende Skins werden nicht hochgeladen, zugewiesen oder bereitgestellt und verschwinden nach dem Anwenden der Konfiguration.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Immer
			Tooltip: Aktiviert immer die ausgewählte lokale Haut.
		}

		AccessoryOnly: {
			$parentVal: Nur Zubehör
			Tooltip: Aktiviert die ausgewählte Haut nur, während der Custom Skin Core sichtbar ist.
		}

		Disabled: {
			$parentVal: Deaktiviert
			Tooltip: Deaktiviert die ausgewählte lokale Haut.
		}

		Tooltip: Wählen Sie, wenn der lokale Charakter-Skin angezeigt wird.
	}

	CustomSkinClientConfig: {
		DisplayName: Benutzerdefinierte Skin-Client-Konfiguration

		EnableMode: {
			Label: Skin-Aktivierungsmodus
			Tooltip: Verwenden Sie immer die ausgewählte Haut, benötigen Sie eine sichtbare Custom Skin Core oder deaktivieren Sie lokale Haut.
		}

		ShowRemoteSkins: {
			Label: CustomSkins anderer Spieler anzeigen
			Tooltip: Wenn deaktiviert, werden Remote-Multiplayer-Skins weder angefordert noch angezeigt. Ihre lokale Haut bleibt davon unberührt.
		}

		BlockedPlayerNames: {
			Label: Skins von Spielernamen ausblenden
			Tooltip: Übereinstimmende Namen verbergen nur das CustomSkin dieses Spielers, nicht den Spieler oder Chat. Beim Abgleichen wird die Groß- und Kleinschreibung ignoriert. Aktualisieren Sie die Liste, wenn der Spieler den Namen ändert.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Skin-Manager öffnen

Commands: {
	Description: Öffnen Sie den CustomSkin-Manager oder laden Sie die Multiplayer-Skins neu.
	Usage: Verwendung: /cskin oder /cskin reload
}

Network: {
	ReloadStarted: Mehrspieler-Skin-Neusynchronisierung angefordert. Fernauftritte kehren nach der Validierung zurück.
	ReloadUnavailable: /cskin reload kann nur nach dem Betreten einer Multiplayer-Welt verwendet werden.
	ReloadHint: Verwenden Sie /cskin reload, um manuell neu zu synchronisieren.
	ServerRejected: Der Server hat eine Skin-Übertragung abgelehnt oder die Validierung ist fehlgeschlagen.
	UploadTimeout: Zeitüberschreitung beim Hochladen des ausgewählten Skins auf den Server.
	DownloadTimeout: Zeitüberschreitung beim Herunterladen des Skin eines anderen Spielers.
	LocalError: Bei der Verarbeitung von Multiplayer-Skin-Daten ist ein Fehler aufgetreten. Überprüfen Sie das Kundenprotokoll auf Details.
}

