Configs: {
	CustomSkinServerConfig: {
		DisplayName: Configuração do servidor CustomSkin

		AllowSkinUploads: {
			Label: Permitir envio de skins dos jogadores
			Tooltip: Quando desativado, o servidor deixa de solicitar novos dados de skin. Skins já armazenadas e não banidas continuam disponíveis.
		}

		MaxUploadKiB: {
			Label: Limite de envio por skin (KiB)
			Tooltip: Limita cada recurso de skin normalizado aceito pelo servidor. O limite rígido do protocolo é 800 KiB.
		}

		MaxCachedResources: {
			Label: Máximo de skins em cache
			Tooltip: Número máximo de skins multijogador diferentes mantidas durante esta sessão do servidor.
		}

		MaxCachedResourceMiB: {
			Label: Tamanho máximo do cache (MiB)
			Tooltip: Limite total de memória para recursos de skin multijogador armazenados pelo servidor.
		}

		UploadCooldownSeconds: {
			Label: Intervalo de solicitação por jogador (segundos)
			Tooltip: Limita a frequência com que o servidor solicita novamente os dados de skin do mesmo jogador.
		}

		BannedSkinHashes: {
			Label: Hashes de skins banidas
			Tooltip: Insira um hash SHA-256 de 64 caracteres por linha. Skins correspondentes não são enviadas, atribuídas ou distribuídas e desaparecem após aplicar a configuração.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Sempre
			Tooltip: Sempre ativa a skin local selecionada.
		}

		AccessoryOnly: {
			$parentVal: Somente acessório
			Tooltip: Ativa a skin selecionada apenas enquanto o Custom Skin Core estiver visível.
		}

		Disabled: {
			$parentVal: Desativado
			Tooltip: Desativa a skin local selecionada.
		}

		Tooltip: Escolha quando a skin do personagem local será exibida.
	}

	CustomSkinClientConfig: {
		DisplayName: Configuração do cliente CustomSkin

		EnableMode: {
			Label: Modo de ativação da skin
			Tooltip: Sempre use a skin selecionada, exija um Custom Skin Core visível ou desative as skins locais.
		}

		ShowRemoteSkins: {
			Label: Mostrar CustomSkins de outros jogadores
			Tooltip: Quando desativado, skins multijogador remotas não são solicitadas nem exibidas. Sua skin local não é afetada.
		}

		BlockedPlayerNames: {
			Label: Ocultar skins pelos nomes dos jogadores
			Tooltip: Nomes correspondentes ocultam apenas a CustomSkin do jogador, não o jogador ou o chat. A comparação ignora maiúsculas; atualize a lista se o jogador mudar de nome.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Abrir gerenciador de skins

Commands: {
	Description: Abre o gerenciador CustomSkin ou recarrega as skins multijogador.
	Usage: Uso: /cskin ou /cskin reload
}

Network: {
	ReloadStarted: Ressincronização das skins multijogador solicitada. As aparências remotas voltarão após a validação.
	ReloadUnavailable: /cskin reload só pode ser usado depois de entrar em um mundo multijogador.
	ReloadHint: Use /cskin reload para ressincronizar manualmente.
	ServerRejected: O servidor rejeitou a transferência de uma skin ou sua validação falhou.
	UploadTimeout: O envio da skin selecionada ao servidor excedeu o tempo limite.
	DownloadTimeout: O download da skin de outro jogador excedeu o tempo limite.
	LocalError: Ocorreu um erro ao processar dados de skin multijogador. Consulte o registro do cliente para obter detalhes.
}

