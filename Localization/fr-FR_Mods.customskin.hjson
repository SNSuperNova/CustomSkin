Configs: {
	CustomSkinServerConfig: {
		DisplayName: Configuration serveur CustomSkin

		AllowSkinUploads: {
			Label: Autoriser l'envoi des skins des joueurs
			Tooltip: Si désactivé, le serveur cesse de demander de nouvelles données de skin. Les skins déjà en cache et non bannis restent disponibles.
		}

		MaxUploadKiB: {
			Label: Limite d'envoi par skin (KiB)
			Tooltip: Limite chaque ressource de skin normalisée acceptée par le serveur. La limite stricte du protocole est de 800 KiB.
		}

		MaxCachedResources: {
			Label: Nombre maximal de skins en cache
			Tooltip: Nombre maximal de skins multijoueur différents conservés pendant cette session du serveur.
		}

		MaxCachedResourceMiB: {
			Label: Taille maximale du cache (MiB)
			Tooltip: Limite totale de mémoire des ressources de skin multijoueur mises en cache par le serveur.
		}

		UploadCooldownSeconds: {
			Label: Délai des demandes d'envoi par joueur (secondes)
			Tooltip: Limite la fréquence à laquelle le serveur redemande les données de skin au même joueur.
		}

		BannedSkinHashes: {
			Label: Empreintes de skins bannis
			Tooltip: Saisissez une empreinte SHA-256 de 64 caractères par ligne. Les skins correspondants ne sont ni envoyés, ni attribués, ni distribués et disparaissent après application de la configuration.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Toujours
			Tooltip: Active toujours le skin local sélectionné.
		}

		AccessoryOnly: {
			$parentVal: Accessoire uniquement
			Tooltip: Active le skin sélectionné uniquement lorsque Custom Skin Core est visible.
		}

		Disabled: {
			$parentVal: Désactivé
			Tooltip: Désactive le skin local sélectionné.
		}

		Tooltip: Choisissez quand afficher le skin du personnage local.
	}

	CustomSkinClientConfig: {
		DisplayName: Configuration client CustomSkin

		EnableMode: {
			Label: Mode d'activation du skin
			Tooltip: Toujours utiliser le skin sélectionné, exiger un Custom Skin Core visible ou désactiver les skins locaux.
		}

		ShowRemoteSkins: {
			Label: Afficher les CustomSkins des autres joueurs
			Tooltip: Si désactivé, les skins multijoueur distants ne sont ni demandés ni affichés. Votre skin local reste inchangé.
		}

		BlockedPlayerNames: {
			Label: Masquer les skins selon le nom du joueur
			Tooltip: Les noms correspondants masquent uniquement la CustomSkin du joueur, pas le joueur ni le chat. La casse est ignorée ; actualisez la liste si le joueur change de nom.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Ouvrir le gestionnaire de skins

Commands: {
	Description: Ouvre le gestionnaire CustomSkin ou recharge les skins multijoueur.
	Usage: Utilisation : /cskin ou /cskin reload
}

Network: {
	ReloadStarted: Resynchronisation des skins multijoueur demandée. Les apparences distantes reviendront après validation.
	ReloadUnavailable: /cskin reload ne peut être utilisé qu'après être entré dans un monde multijoueur.
	ReloadHint: Utilisez /cskin reload pour resynchroniser manuellement.
	ServerRejected: Le serveur a refusé un transfert de skin ou sa validation a échoué.
	UploadTimeout: Délai dépassé lors de l'envoi du skin sélectionné au serveur.
	DownloadTimeout: Délai dépassé lors du téléchargement du skin d'un autre joueur.
	LocalError: Une erreur est survenue pendant le traitement des données de skin multijoueur. Consultez le journal client pour plus de détails.
}

