Configs: {
	CustomSkinServerConfig: {
		DisplayName: 自定义皮肤服务器配置

		AllowSkinUploads: {
			Label: 允许玩家上传皮肤
			Tooltip: 关闭后服务器不会向玩家请求新的皮肤数据；已经缓存且未封禁的皮肤仍可继续显示。
		}

		MaxUploadKiB: {
			Label: 单个皮肤上传上限（KiB）
			Tooltip: 限制服务器接受的单个标准化皮肤资源大小。协议自身的硬上限为 800 KiB。
		}

		MaxCachedResources: {
			Label: 最大缓存皮肤数量
			Tooltip: 服务器本次运行期间可保留的不同联机皮肤数量。
		}

		MaxCachedResourceMiB: {
			Label: 最大缓存总量（MiB）
			Tooltip: 服务器内存中联机皮肤资源的总容量上限。
		}

		UploadCooldownSeconds: {
			Label: 同一玩家上传请求冷却（秒）
			Tooltip: 限制服务器向同一玩家重复请求皮肤数据的频率。
		}

		BannedSkinHashes: {
			Label: 封禁的皮肤哈希
			Tooltip: 每行填写一个 64 位 SHA-256 哈希。匹配的皮肤不会上传、分配或下发；修改配置后会立即停止显示。
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: 始终启用
			Tooltip: 始终显示当前角色选择的本地皮肤。
		}

		AccessoryOnly: {
			$parentVal: 仅显示饰品时启用
			Tooltip: 只有在显示“自定义外观核心”时才启用当前皮肤。
		}

		Disabled: {
			$parentVal: 禁用
			Tooltip: 不显示当前角色选择的本地皮肤。
		}

		Tooltip: 选择何时显示本地角色皮肤。
	}

	CustomSkinClientConfig: {
		DisplayName: 自定义皮肤客户端配置

		EnableMode: {
			Label: 皮肤启用方式
			Tooltip: 可选择始终使用当前皮肤、仅在显示自定义外观核心时启用，或关闭本地皮肤。
		}

		ShowRemoteSkins: {
			Label: 显示其他玩家的 CustomSkin
			Tooltip: 关闭后不再请求或显示联机玩家的远端皮肤；本地皮肤不受影响。
		}

		BlockedPlayerNames: {
			Label: 屏蔽皮肤的玩家名称
			Tooltip: 名称匹配时只隐藏该玩家的 CustomSkin，不屏蔽玩家或聊天。名称不区分大小写；玩家改名后需要更新列表。
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: 打开皮肤管理器

Commands: {
	Description: 打开 CustomSkin 管理器，或重新同步联机皮肤。
	Usage: 用法：/cskin 或 /cskin reload
}

Network: {
	ReloadStarted: 已请求重新同步联机皮肤；远端外观会在校验完成后恢复。
	ReloadUnavailable: 只能在进入联机世界并完成加载后使用 /cskin reload。
	ReloadHint: 可输入 /cskin reload 手动重新同步。
	ServerRejected: 服务器拒绝了皮肤传输或皮肤数据校验失败。
	UploadTimeout: 向服务器上传当前皮肤时超时。
	DownloadTimeout: 获取其他玩家的皮肤时超时。
	LocalError: 处理联机皮肤数据时发生异常，详情请查看客户端日志。
}

