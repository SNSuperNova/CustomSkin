Configs: {
	CustomSkinServerConfig: {
		DisplayName: Настройки сервера CustomSkin

		AllowSkinUploads: {
			Label: Разрешить загрузку скинов игроков
			Tooltip: Если отключено, сервер перестаёт запрашивать новые данные скинов. Уже кэшированные и не запрещённые скины остаются доступными.
		}

		MaxUploadKiB: {
			Label: Лимит загрузки одного скина (KiB)
			Tooltip: Ограничивает размер каждого нормализованного ресурса скина, принимаемого сервером. Жёсткий лимит протокола — 800 KiB.
		}

		MaxCachedResources: {
			Label: Максимальное число скинов в кэше
			Tooltip: Максимальное число различных сетевых скинов, хранимых во время этой сессии сервера.
		}

		MaxCachedResourceMiB: {
			Label: Максимальный размер кэша (MiB)
			Tooltip: Общий лимит памяти для сетевых ресурсов скинов, кэшируемых сервером.
		}

		UploadCooldownSeconds: {
			Label: Задержка запросов загрузки игрока (секунды)
			Tooltip: Ограничивает частоту повторных запросов данных скина у одного игрока.
		}

		BannedSkinHashes: {
			Label: Хеши запрещённых скинов
			Tooltip: Введите по одному 64-символьному хешу SHA-256 в строке. Совпавшие скины не загружаются, не назначаются и не передаются и исчезают после применения настроек.
		}
	}

	SkinEnableMode: {
		Always: {
			$parentVal: Всегда
			Tooltip: Всегда включает выбранный локальный скин.
		}

		AccessoryOnly: {
			$parentVal: Только аксессуар
			Tooltip: Включает выбранный скин, только когда виден Custom Skin Core.
		}

		Disabled: {
			$parentVal: Отключено
			Tooltip: Отключает выбранный локальный скин.
		}

		Tooltip: Выберите, когда отображать локальный скин персонажа.
	}

	CustomSkinClientConfig: {
		DisplayName: Настройки клиента CustomSkin

		EnableMode: {
			Label: Режим включения скина
			Tooltip: Всегда использовать выбранный скин, требовать видимый Custom Skin Core или отключить локальные скины.
		}

		ShowRemoteSkins: {
			Label: Показывать CustomSkin других игроков
			Tooltip: Если отключено, сетевые скины не запрашиваются и не показываются. Ваш локальный скин не меняется.
		}

		BlockedPlayerNames: {
			Label: Скрывать скины по именам игроков
			Tooltip: Совпавшие имена скрывают только CustomSkin игрока, но не игрока и не чат. Регистр не учитывается; обновите список, если игрок сменил имя.
		}
	}
}

Keybinds.OpenSkinManager.DisplayName: Открыть менеджер скинов

Commands: {
	Description: Открывает менеджер CustomSkin или перезагружает сетевые скины.
	Usage: Использование: /cskin или /cskin reload
}

Network: {
	ReloadStarted: Запрошена повторная синхронизация сетевых скинов. Облики других игроков вернутся после проверки.
	ReloadUnavailable: /cskin reload можно использовать только после входа в сетевой мир.
	ReloadHint: Используйте /cskin reload для ручной синхронизации.
	ServerRejected: Сервер отклонил передачу скина или его проверка не удалась.
	UploadTimeout: Истекло время загрузки выбранного скина на сервер.
	DownloadTimeout: Истекло время скачивания скина другого игрока.
	LocalError: При обработке сетевых данных скина произошла ошибка. Подробности смотрите в журнале клиента.
}

